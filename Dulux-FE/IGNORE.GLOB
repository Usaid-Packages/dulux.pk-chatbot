[ignore]
glob = [
  '*.md',
  '*.txt',
  'node_modules/**',
  'dist/**',
  'build/**',
  '.vite/**',
  'public/**',
  '*.lock',
  'yarn.lock',
  'package-lock.json',
  '*.config.js',
  '*.config.ts',
  '.env*',
  '*.svg',
  '*.png',
  '*.jpg',
  '*.jpeg',
  '*.gif',
  '*.ico',
  '*.woff',
  '*.woff2',
  '*.ttf',
]
